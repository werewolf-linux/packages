SPDX-License-Identifier: PHP-3.01
Subject: [PATCH] Gate session upload progress separately from file uploads
Upstream-Status: Inappropriate [fixed Werewolf appliance policy]
Reference: https://www.php.net/manual/en/session.upload-progress.php
Base-Commit: 678778973bb4d4185c06ef1320de50f1a975d3c8

--- a/ext/session/session.c
+++ b/ext/session/session.c
@@ -24,3 +24,4 @@
 #include "php.h"
+#include "main/runtime_hardening_log.h"
 
 #ifdef PHP_WIN32
@@ -3187,6 +3188,19 @@
 		return retval;
 	}
 
+	/* Decide once per multipart body, before progress allocation, session
+	 * decoding or updates. A denied START must skip every subsequent event;
+	 * an allowance created mid-body must not enter uninitialized state. */
+	if (event == MULTIPART_EVENT_START) {
+		if (!php_werewolf_allowed("upload-progress")) {
+			runtime_hardening_denied("php", "upload-progress",
+				"session.upload_progress", "multipart/form-data");
+			return retval;
+		}
+	} else if (!PS(rfc1867_progress)) {
+		return retval;
+	}
+
 	progress = PS(rfc1867_progress);
 
 	switch(event) {
