SPDX-License-Identifier: PHP-3.01
Subject: [PATCH] Require an upload allowance before parsing multipart bodies
Upstream-Status: Inappropriate [fixed Werewolf appliance policy]
Reference: https://www.php.net/manual/en/function.request-parse-body.php
Base-Commit: 678778973bb4d4185c06ef1320de50f1a975d3c8

--- a/main/rfc1867.c
+++ b/main/rfc1867.c
@@ -22,5 +22,6 @@
 #include <stdio.h>
 #include "php.h"
+#include "runtime_hardening_log.h"
 #include "php_open_temporary_file.h"
 #include "zend_globals.h"
 #include "php_globals.h"
@@ -685,6 +686,16 @@
 		} \
 	} while (0)
 
+	/* Gate the shared POST/request_parse_body path before boundary parsing,
+	 * temporary files and upload-progress callbacks. file_uploads=Off alone
+	 * still parses multipart input. Text-only multipart needs this grant too. */
+	if (!php_werewolf_allowed("upload")) {
+		runtime_hardening_denied("php", "upload", "parse", "multipart/form-data");
+		EMIT_WARNING_OR_ERROR("multipart parsing is refused: "
+			"the image allows it only by php:upload");
+		return;
+	}
+
 	if (php_rfc1867_encoding_translation() && internal_encoding) {
 		getword = php_rfc1867_getword;
 		getword_conf = php_rfc1867_getword_conf;
--- a/ext/standard/basic_functions.c
+++ b/ext/standard/basic_functions.c
@@ -17,5 +17,6 @@
 
 #include "php.h"
+#include "main/runtime_hardening_log.h"
 #include "php_assert.h"
 #include "php_crypt.h"
 #include "php_streams.h"
@@ -2373,6 +2374,14 @@
 		Z_PARAM_PATH_STR(new_path)
 	ZEND_PARSE_PARAMETERS_END();
 
+	/* Recheck at use, including revocation after the body was parsed. */
+	if (!php_werewolf_allowed("upload")) {
+		runtime_hardening_denied("php", "upload", "move_uploaded_file", ZSTR_VAL(new_path));
+		php_error_docref(NULL, E_WARNING, "moving an uploaded file is refused: "
+			"the image allows it only by php:upload");
+		RETURN_FALSE;
+	}
+
 	if (!SG(rfc1867_uploaded_files)) {
 		RETURN_FALSE;
 	}
