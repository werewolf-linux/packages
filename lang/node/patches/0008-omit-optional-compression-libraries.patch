Subject: [PATCH] Make Brotli and Zstd optional at build time
Upstream-Status: Pending
Reference: https://github.com/nodejs/node/tree/v26.12.1

Omit codec implementations, linkage and APIs together. Keep numeric constants
for zlib module initialization and feature detection through constructor absence.
Fetch advertises only the codecs this build can decode.

diff --git a/configure.py b/configure.py
--- a/configure.py
+++ b/configure.py
@@ -703,6 +703,9 @@
     dest='shared_merve_libpath',
     help='a directory to search for the shared merve DLL')
 
+parser.add_argument('--without-brotli', action='store_true',
+    help='omit brotli compression and decompression')
+
 shared_optgroup.add_argument('--shared-brotli',
     action='store_true',
     dest='shared_brotli',
@@ -812,6 +815,9 @@
     action='store',
     dest='shared_temporal_capi_libpath',
     help='a directory to search for the shared temporal_capi DLL')
+
+parser.add_argument('--without-zstd', action='store_true',
+    help='omit zstd compression and decompression')
 
 shared_optgroup.add_argument('--shared-zstd',
     action='store_true',
@@ -2964,7 +2970,13 @@
 configure_library('ada', output)
 configure_library('simdjson', output)
 configure_library('simdutf', output)
-configure_library('brotli', output, pkgname=['libbrotlidec', 'libbrotlienc'])
+output['variables']['node_use_brotli'] = b(not options.without_brotli)
+if options.without_brotli:
+    if options.shared_brotli:
+        error('--without-brotli conflicts with --shared-brotli')
+    output['variables']['node_shared_brotli'] = 'false'
+else:
+    configure_library('brotli', output, pkgname=['libbrotlidec', 'libbrotlienc'])
 configure_library('cares', output, pkgname='libcares')
 # Only cctest uses gtest; keep it out of the node binary's link line.
 output['variables']['node_shared_gtest_libraries'] = []
@@ -2982,7 +2994,13 @@
 configure_ffi(output);
 configure_library('temporal_capi', output)
 configure_library('uvwasi', output)
-configure_library('zstd', output, pkgname='libzstd')
+output['variables']['node_use_zstd'] = b(not options.without_zstd)
+if options.without_zstd:
+    if options.shared_zstd:
+        error('--without-zstd conflicts with --shared-zstd')
+    output['variables']['node_shared_zstd'] = 'false'
+else:
+    configure_library('zstd', output, pkgname='libzstd')
 configure_v8(output, configurations)
 configure_openssl(output)
 configure_quic(output)
