diff --git a/lib/zlib.js b/lib/zlib.js
--- a/lib/zlib.js
+++ b/lib/zlib.js
@@ -1209,3 +1209,22 @@
     writable: false,
   });
 }
+
+// Numeric constants remain available, but omitted native codecs must not be
+// advertised by callers that feature-detect the public API.
+if (binding.BrotliEncoder === undefined) {
+  for (const name of ['BrotliCompress', 'BrotliDecompress',
+                     'createBrotliCompress', 'createBrotliDecompress',
+                     'brotliCompress', 'brotliCompressSync',
+                     'brotliDecompress', 'brotliDecompressSync']) {
+    delete module.exports[name];
+  }
+}
+if (binding.ZstdCompress === undefined) {
+  for (const name of ['ZstdCompress', 'ZstdDecompress',
+                     'createZstdCompress', 'createZstdDecompress',
+                     'zstdCompress', 'zstdCompressSync',
+                     'zstdDecompress', 'zstdDecompressSync']) {
+    delete module.exports[name];
+  }
+}
