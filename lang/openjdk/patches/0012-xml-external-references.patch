Subject: [PATCH] Refuse XML external references the catalog does not resolve
Upstream-Status: Inappropriate [fixed Werewolf appliance policy]
Reference: werewolf docs/design/hardened-interpreters.md
Base-Commit: 815ff4dc327fe17f2433c7d115a5a503af10f3c4

diff --git a/src/java.xml/share/conf/jaxp.properties b/src/java.xml/share/conf/jaxp.properties
--- a/src/java.xml/share/conf/jaxp.properties
+++ b/src/java.xml/share/conf/jaxp.properties
@@ -136,10 +136,10 @@
 #     ignore -- indicates that the reference is skipped
 #     strict -- indicates that the resolver should throw a CatalogException
 #
-# The following setting allows the resolution to continue in cases where
-# external references are not resolved by a user-defined resolver or catalog if
-# any, and the built-in Catalog:
-jdk.xml.jdkcatalog.resolve=continue
+# Werewolf: an external reference that neither a user-defined resolver or
+# catalog nor the built-in Catalog resolves is refused, never fetched, so an
+# XML document cannot read a file or a URL (XML external entities):
+jdk.xml.jdkcatalog.resolve=strict
 #
 # Implementation Specific Properties - DTD
 #
