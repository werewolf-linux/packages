@@ -0,0 +1,208 @@
+/* Audit callbacks must remain inert even when registration state is forged.
+   SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#define SHARED 1
+/* This probe runs after startup and links ordinary libc memory functions.  */
+#include <sysdeps/generic/dl-symbol-redir-ifunc.h>
+#include <ldsodefs.h>
+#include <support/check.h>
+#include <string.h>
+
+/* Compile the real dispatch against private state, not the running loader.
+   For a positive control, set AUDIT_SOURCE to the unpatched dl-audit.c and
+   EXPECT_AUDIT to 1.  No offsets or copies of glibc's internal types.  */
+#ifndef AUDIT_SOURCE
+# define AUDIT_SOURCE "dl-audit.c"
+#endif
+#ifndef EXPECT_AUDIT
+# define EXPECT_AUDIT 0
+#endif
+
+static struct rtld_global_ro fixture_ro;
+static struct rtld_global fixture_rw;
+struct link_map _dl_rtld_map;
+struct auditstate _dl_rtld_auditstate[DL_NNS];
+
+#undef GLRO
+#define GLRO(name) fixture_ro._##name
+#undef GL
+#define GL(name) fixture_rw._##name
+#include AUDIT_SOURCE
+
+#if defined __x86_64__
+typedef La_x86_64_regs audit_regs;
+typedef La_x86_64_retval audit_retval;
+typedef unsigned int audit_exit_result;
+#elif defined __aarch64__
+typedef La_aarch64_regs audit_regs;
+typedef La_aarch64_retval audit_retval;
+typedef ElfW(Addr) audit_exit_result;
+#else
+# error "Define the audit register types for this architecture"
+#endif
+
+enum { original = 0x1000, replacement = 0x2000 };
+static unsigned int calls;
+
+static void
+activity (uintptr_t *cookie, unsigned int action)
+{
+  ++calls;
+}
+
+static char *
+objsearch (const char *name, uintptr_t *cookie, unsigned int code)
+{
+  ++calls;
+  return (char *) "substituted";
+}
+
+static unsigned int
+objopen (struct link_map *map, Lmid_t nsid, uintptr_t *cookie)
+{
+  ++calls;
+  return LA_FLG_BINDFROM | LA_FLG_BINDTO;
+}
+
+static unsigned int
+objclose (uintptr_t *cookie)
+{
+  ++calls;
+  return 0;
+}
+
+static void
+preinit (uintptr_t *cookie)
+{
+  ++calls;
+}
+
+static uintptr_t
+symbind (ElfW(Sym) *sym, unsigned int ndx, uintptr_t *from, uintptr_t *to,
+         unsigned int *flags, const char *name)
+{
+  ++calls;
+  return replacement;
+}
+
+static ElfW(Addr)
+pltenter (ElfW(Sym) *sym, unsigned int ndx, uintptr_t *from, uintptr_t *to,
+          audit_regs *regs, unsigned int *flags, const char *name,
+          long int *framesize)
+{
+  ++calls;
+  *framesize = 64;
+  return replacement;
+}
+
+static audit_exit_result
+pltexit (ElfW(Sym) *sym, unsigned int ndx, uintptr_t *from, uintptr_t *to,
+         const audit_regs *in, audit_retval *out, const char *name)
+{
+  ++calls;
+  return 0;
+}
+
+static void
+check_calls (void)
+{
+  TEST_COMPARE (calls, EXPECT_AUDIT);
+  calls = 0;
+}
+
+static int
+do_test (void)
+{
+  struct audit_ifaces callbacks =
+    {
+      .activity = activity, .objsearch = objsearch, .objopen = objopen,
+      .objclose = objclose, .preinit = preinit, .symbind = symbind,
+      .ARCH_LA_PLTENTER = pltenter, .ARCH_LA_PLTEXIT = pltexit
+    };
+  struct
+    {
+      struct link_map map;
+      struct auditstate audit;
+    } object = { 0 };
+  _Static_assert (offsetof (__typeof (object), audit) == sizeof (object.map),
+                  "audit state must immediately follow the link map");
+  struct link_map *map = &object.map;
+  ElfW(Sym) symbol = { .st_value = original };
+  ElfW(Dyn) symbols = { .d_un.d_ptr = (ElfW(Addr)) &symbol };
+  ElfW(Dyn) strings = { .d_un.d_ptr = (ElfW(Addr)) "probe" };
+  ElfW(Dyn) plt = { 0 };
+  struct reloc_result relocation = { 0 };
+  audit_regs regs = { 0 };
+  audit_retval retval = { 0 };
+  map->l_info[DT_SYMTAB] = &symbols;
+  map->l_info[DT_STRTAB] = &strings;
+  map->l_info[DT_PLTGOT] = &plt;
+  map->l_reloc_result = &relocation;
+  map->l_audit_any_plt = 1;
+  object.audit.bindflags = LA_FLG_BINDFROM | LA_FLG_BINDTO;
+  GLRO (dl_audit) = &callbacks;
+  GLRO (dl_naudit) = 1;
+  GL (dl_ns)[0]._ns_loaded = map;
+
+  _dl_audit_activity_map (map, LA_ACT_ADD);
+  check_calls ();
+  _dl_audit_activity_nsid (0, LA_ACT_CONSISTENT);
+  check_calls ();
+  const char *name = _dl_audit_objsearch ("probe", map, LA_SER_ORIG);
+  TEST_COMPARE_STRING (name, EXPECT_AUDIT ? "substituted" : "probe");
+  check_calls ();
+  _dl_audit_objopen (map, 0);
+  check_calls ();
+  _dl_audit_objclose (map);
+  check_calls ();
+  _dl_audit_preinit (map);
+  check_calls ();
+
+  void *address = (void *) original;
+  _dl_audit_symbind_alt (map, &symbol, &address, map);
+  TEST_COMPARE ((uintptr_t) address, EXPECT_AUDIT ? replacement : original);
+  check_calls ();
+
+  for (int lazy = 0; lazy != 2; ++lazy)
+    {
+      DL_FIXUP_VALUE_TYPE value = original;
+      _dl_audit_symbind (map, lazy ? &relocation : NULL, NULL, &symbol,
+                        &value, map, lazy);
+      TEST_COMPARE (value, EXPECT_AUDIT ? replacement : original);
+      check_calls ();
+    }
+
+  /* Supply interested PLT state independently of the symbind result.  */
+  relocation.bound = map;
+  relocation.boundndx = 0;
+  relocation.addr = original;
+  relocation.flags = 0;
+  relocation.enterexit = 0;
+  DL_FIXUP_VALUE_TYPE value = original;
+  long int framesize = -1;
+  _dl_audit_pltenter (map, &relocation, &value, &regs, &framesize);
+  TEST_COMPARE (value, EXPECT_AUDIT ? replacement : original);
+  TEST_COMPARE (framesize, EXPECT_AUDIT ? 64 : -1);
+  check_calls ();
+  _dl_audit_pltexit (map, 0, &regs, &retval);
+  check_calls ();
